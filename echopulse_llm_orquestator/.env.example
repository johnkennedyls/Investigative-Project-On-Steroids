# =====================================================================
# EchoPulse AI — configuración de la voz (LLM) y de los módulos
# =====================================================================
# Copia este archivo como .env y descomenta solo lo que vayas a usar.
# Todo es opcional: sin nada configurado, el agente usa Ollama local y, si
# tampoco está, responde con el motor conversacional determinista.

# --- Hugging Face (opcional) -----------------------------------------
# El router de HF ya NO da Qwen gratis: sin créditos responde
# 402 "You have no remaining credits". Solo se usa si tiene créditos.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# HF_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507

# --- Ollama local con Qwen (gratis, sin cuenta) ----------------------
# 1) ollama pull qwen2.5:3b-instruct-q4_K_M
#    (o el GGUF oficial de HF: hf.co/Qwen/Qwen2.5-3B-Instruct-GGUF:Q4_K_M)
OLLAMA_ENABLED=1
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
# OLLAMA_KEEP_ALIVE=30m

# --- Cualquier endpoint compatible OpenAI (Space propio, vLLM, etc.) -
# Ej.: un Hugging Face Space con Qwen: https://usuario-espacio.hf.space/v1
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=qwen

# --- Alternativas gratis con key (Qwen servido por terceros) ---------
# Groq (console.groq.com) — Qwen3-32B rápido y con cupo diario gratis
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3-32b

# Alibaba ModelStudio / DashScope — Qwen nativo con cuota de prueba
# DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen-plus

# OpenRouter — solo si hay algún Qwen con sufijo :free disponible
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=qwen/qwen3-4b:free

# --- Ajustes de comportamiento ---------------------------------------
# Orden de proveedores. Por defecto: custom,groq,dashscope,openrouter,hf,ollama
# LLM_ORDER=custom,ollama
# Intención: auto (LLM solo si la heurística no alcanza) | llm | heuristica
# INTENT_MODE=auto
# LLM_MAX_TOKENS_CHAT=160
# LLM_TEMPERATURA_CHAT=0.7

# --- Servidor ---------------------------------------------------------
# PORT=5000
# FLASK_DEBUG=0
